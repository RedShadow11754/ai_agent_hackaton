# Copy this file to `.env` for local development:  cp .env.example .env
#
# HARD RULE 4: no secrets in the repo and none in the frontend. The frontend is
# a static build that only talks to /api on the same origin, so it never needs
# any of these values. Real keys belong in Render environment variables.

# --- LLM (Gemini free tier) ---
# Get a key at https://aistudio.google.com/app/apikey and confirm free-tier
# function-calling support for the model you pick.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
# gemini = real calls | fake = deterministic offline stub for demos and tests
LLM_PROVIDER=gemini

# --- Supabase Postgres (backend only; the service key bypasses RLS) ---
# Project settings -> API -> Project URL / service_role secret.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# --- Guardrails ---
MAX_TOOL_CALLS=8
MAX_MESSAGE_CHARS=8000
RATE_LIMIT_PER_MINUTE=30

# --- App ---
ENVIRONMENT=development
# Comma-separated. Only used by CORS in local dev; in production FastAPI serves
# the built frontend from the same origin, so CORS is not needed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
